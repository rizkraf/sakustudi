# PostgreSQL
DATABASE_URL=postgres://sakustudi:sakustudi@localhost:5432/sakustudi
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Redis + queues (BullMQ). The worker process (npm run worker) reads these
# too; reconciliation re-enqueues pending work after Redis recovers.
REDIS_URL=redis://localhost:6379

# Rate limiting (Redis-backed, fail-open). Set RATE_LIMIT_ENABLED=false to
# disable (e.g. for automated tests). Each RATE_LIMIT_*_MAX overrides the
# default; 0 or empty keeps the default.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_EMAIL_MAX=5
RATE_LIMIT_REGISTER_IP_MAX=5
RATE_LIMIT_FORGOT_IP_MAX=5
RATE_LIMIT_RESET_IP_MAX=10
RATE_LIMIT_API_IP_MAX=60
RATE_LIMIT_UPLOAD_MAX=60

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of additional origins allowed to make auth requests
BETTER_AUTH_TRUSTED_ORIGINS=
# Set to "true" to force secure cookies over http (e.g. behind a TLS proxy)
BETTER_AUTH_SECURE_COOKIES=false

# Mail (SMTP adapter; optional for local development)
MAIL_ADAPTER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SakuStudi <no-reply@sakustudi.local>
# For tests/local dev: MAIL_ADAPTER=memory or MAIL_ADAPTER=file with MAIL_FILE_PATH=.tmp/mail.json
# The email-reminder toggle only appears when a real SMTP transport is
# configured (MAIL_ADAPTER unset or "smtp").

# Private file storage
# Driver: local (default, files on disk outside the web root) or s3
# (S3-compatible bucket; credentials never reach the browser)
STORAGE_DRIVER=local
# Directory for local storage (relative paths resolve against the project root)
STORAGE_LOCAL_ROOT=./storage
# S3-compatible adapter (only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for MinIO or other path-style S3-compatible endpoints
S3_FORCE_PATH_STYLE=false
# Upload limits (bytes)
MAX_UPLOAD_BYTES=10485760
MAX_STORAGE_BYTES=104857600

# Docker Compose (self-hosted production)
POSTGRES_PASSWORD=replace-with-a-strong-db-password
